<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/panel_intelligence">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT IMAGE SOURCE"
        android:textColor="#F2FAFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose Gallery for photo albums, Files for individual documents, or Folder for very large collections."
        android:textColor="#7DAEA2"
        android:textSize="9sp" />

    <Button
        android:id="@+id/gallerySourceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="OPEN GALLERY / STUDIO"
        android:textColor="#7DFF19"
        android:textStyle="bold"
        android:background="@drawable/bg_intel_button" />

    <Button
        android:id="@+id/filesSourceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="OPEN SYSTEM FILES"
        android:textColor="#49D9FF"
        android:textStyle="bold"
        android:background="@drawable/bg_intel_button" />

    <Button
        android:id="@+id/folderSourceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SELECT FOLDER / LARGE CORPUS"
        android:textColor="#E9FFD2"
        android:textStyle="bold"
        android:background="@drawable/bg_intel_button" />
</LinearLayout>
