<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/bg_intel_panel"
    android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="EVIDENCE RECORD" android:textColor="#49D9FF" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.10" />
        <TextView android:id="@+id/language" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#7DFF19" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>
    <ImageView android:id="@+id/imagePreview" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="8dp" android:scaleType="centerCrop" android:contentDescription="الصورة" />
    <TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F2FAFF" android:textStyle="bold" android:textSize="16sp" android:paddingTop="9dp" />
    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#83A6BF" android:textSize="11sp" />
    <TextView android:id="@+id/filePath" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#58758B" android:textSize="10sp" android:ellipsize="middle" android:maxLines="2" />
    <TextView android:id="@+id/detectedObjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFC857" android:textSize="12sp" android:textStyle="bold" android:paddingTop="7dp" android:maxLines="3" />
    <TextView android:id="@+id/ocrText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C8D8E4" android:textSize="13sp" android:maxLines="8" android:paddingTop="6dp" />
</LinearLayout>
