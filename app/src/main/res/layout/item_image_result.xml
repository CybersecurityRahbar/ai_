<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="10dp">

    <ImageView
        android:id="@+id/imagePreview"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:contentDescription="الصورة" />

    <TextView
        android:id="@+id/fileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E7F2FF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="9dp" />

    <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#7F9DB3" android:textSize="12sp" />
    <TextView android:id="@+id/language" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#6E91AA" android:textSize="11sp" />
    <TextView android:id="@+id/filePath" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#58758B" android:textSize="10sp" android:ellipsize="middle" android:maxLines="2" />
    <TextView android:id="@+id/detectedObjects" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#62B7D9" android:textSize="12sp" android:textStyle="bold" android:paddingTop="6dp" android:maxLines="3" />
    <TextView android:id="@+id/ocrText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B8C9D6" android:textSize="13sp" android:maxLines="8" android:paddingTop="6dp" />
</LinearLayout>
