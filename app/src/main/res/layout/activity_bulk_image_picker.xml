<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/bg_intelligence">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/panel_intelligence">
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECT LOCAL IMAGES"
            android:textColor="#F2FAFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/summaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="VISIBLE 0 • SELECTED 0"
            android:textColor="#7DFF19"
            android:textSize="9sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/openSystemImagesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="OPEN SYSTEM FILES / GALLERY"
            android:textColor="#49D9FF"
            android:textStyle="bold"
            android:allCaps="false"
            android:background="@drawable/bg_intel_button" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Files • Gallery • folders • document providers • multi-select"
            android:textColor="#7DAEA2"
            android:textSize="8sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/selectAllButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SELECT ALL"
                android:textColor="#E9FFD2"
                android:background="@drawable/bg_intel_button" />
            <Button
                android:id="@+id/loadMoreButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="LOAD NEXT 100"
                android:textColor="#49D9FF"
                android:background="@drawable/bg_intel_button" />
            <Button
                android:id="@+id/doneButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="ADD SELECTED"
                android:textColor="#7DFF19"
                android:background="@drawable/bg_intel_button" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/imagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/panel_intelligence"
        android:padding="5dp" />
</LinearLayout>
