<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03070A">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="الصورة الأصلية" />

    <View
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_intel_panel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <Button
            android:id="@+id/closeButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textColor="#7DFF19"
            android:textSize="25sp"
            android:textStyle="bold"
            android:background="@drawable/bg_intel_button" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EVIDENCE VIEWER"
                android:textColor="#49D9FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORIGINAL IMAGE / VISUAL EVIDENCE"
                android:textColor="#F2FAFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingTop="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#7DFF19"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_status_ok"
            android:padding="7dp" />
    </LinearLayout>
</FrameLayout>
