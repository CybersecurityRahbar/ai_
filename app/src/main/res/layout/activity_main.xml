<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A111A"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERSONAL MEMORY AI" android:textColor="#E7F2FF" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL INTELLIGENCE • VISION ANALYTICS" android:textColor="#6F91AD" android:textSize="10sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LOCAL" android:textColor="#48C7A5" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingTop="12dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  OVERVIEW  " android:textColor="#E7F2FF" android:background="#173C5E" android:padding="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  INDEX  " android:textColor="#7894AA" android:padding="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  SEARCH  " android:textColor="#7894AA" android:padding="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  ENTITIES  " android:textColor="#7894AA" android:padding="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  MODELS  " android:textColor="#7894AA" android:padding="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMAGE INDEX" android:textColor="#6F91AD" android:textSize="9sp" />
            <TextView android:id="@+id/counterText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#E7F2FF" android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="74dp" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ENGINE" android:textColor="#6F91AD" android:textSize="9sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YOLO • OCR • FACE • CLIP" android:textColor="#B8D8EE" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MODEL CONTROL / MOBILECLIP-S2" android:textColor="#8DB7D6" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/modelStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ MobileCLIP-S2 غير مستورد" android:textColor="#E7F2FF" android:textSize="13sp" android:paddingTop="6dp" />
        <Button android:id="@+id/importModelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="IMPORT LOCAL TFLITE MODEL" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
        <Button android:id="@+id/buildVisualIndexButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="BUILD / UPDATE VISUAL INDEX" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
        <Button android:id="@+id/dataCenterButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="DATA CENTER • BACKUP / RESTORE / MODELS" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="10dp">
        <TextView android:id="@+id/faceStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FACE INDEX • 0 وجه • 0 بصمة" android:textColor="#B8D8EE" android:textSize="11sp" android:textStyle="bold" />
        <Button android:id="@+id/buildFaceIndexButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="BUILD FACE INTELLIGENCE INDEX" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/selectButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp" android:text="فهرسة الصور" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
        <Button android:id="@+id/semanticSearchButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="بحث بصري" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />
    </LinearLayout>

    <EditText android:id="@+id/searchEditText" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:hint="ابحث: رجل + غرفة + كلب ..." android:hintTextColor="#597287" android:textColor="#E7F2FF" android:textColorHighlight="#2B668F" android:inputType="text" android:textDirection="locale" android:background="@drawable/bg_search" />

    <Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="RUN INTELLIGENCE SEARCH" android:textColor="#FFFFFF" android:background="@drawable/bg_primary_button" />

    <ProgressBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="9dp" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" />

    <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SYSTEM READY" android:textColor="#83A6BF" android:textSize="11sp" android:paddingTop="8dp" android:paddingBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/resultsRecyclerView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="4dp" />

</LinearLayout>
