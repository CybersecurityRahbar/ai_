<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#04090D">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="◈  LOCAL INTELLIGENCE COMMAND" android:textColor="#7DFF19" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FACE INTELLIGENCE SYSTEM" android:textColor="#F2FAFF" android:textSize="25sp" android:textStyle="bold" android:paddingTop="5dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IDENTITY  •  VISUAL  •  OCR  •  OBJECTS  •  EVIDENCE" android:textColor="#71A0B8" android:textSize="9sp" android:paddingTop="5dp" />
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="●  SYSTEM READY  /  LOCAL INFERENCE ONLINE" android:textColor="#7DFF19" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_status_ok" android:padding="9dp" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="SYSTEM TELEMETRY" android:textColor="#7196AA" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" />
    <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="2" android:useDefaultMargins="false" android:paddingTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_marginEnd="5dp" android:layout_marginBottom="5dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IMAGES" android:textColor="#5E8296" android:textSize="9sp"/><TextView android:id="@+id/counterText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#7DFF19" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_marginStart="5dp" android:layout_marginBottom="5dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FACE OBSERVATIONS" android:textColor="#5E8296" android:textSize="9sp"/><TextView android:id="@+id/faceMetricText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#49D9FF" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_marginEnd="5dp" android:layout_marginTop="5dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PERSON CLUSTERS" android:textColor="#5E8296" android:textSize="9sp"/><TextView android:id="@+id/personMetricText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#B66CFF" android:textSize="23sp" android:textStyle="bold"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="86dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_marginStart="5dp" android:layout_marginTop="5dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OPERATION" android:textColor="#5E8296" android:textSize="9sp"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCAL / ON-DEVICE" android:textColor="#FFC857" android:textSize="13sp" android:textStyle="bold" android:paddingTop="6dp"/></LinearLayout>
    </GridLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ENGINE CONTROL MATRIX" android:textColor="#49D9FF" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RUNTIME TELEMETRY / DIAGNOSTICS SURFACE" android:textColor="#5E8296" android:textSize="8sp" android:paddingTop="3dp" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● MONITOR" android:textColor="#7DFF19" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_status_ok" android:padding="6dp" />
        </LinearLayout>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="false" android:paddingTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:layout_marginEnd="4dp" android:layout_marginBottom="4dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FACE IDENTITY" android:textColor="#E5F4FA" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EMBEDDING + SHAPE" android:textColor="#7DFF19" android:textSize="8sp" android:paddingTop="4dp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:layout_marginStart="4dp" android:layout_marginBottom="4dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VISUAL SEARCH" android:textColor="#E5F4FA" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MOBILECLIP-S2" android:textColor="#49D9FF" android:textSize="8sp" android:paddingTop="4dp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:layout_marginEnd="4dp" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OCR / OBJECTS" android:textColor="#E5F4FA" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ANALYSIS PIPELINE" android:textColor="#FFC857" android:textSize="8sp" android:paddingTop="4dp"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:layout_marginStart="4dp" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="9dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DIAGNOSTICS" android:textColor="#E5F4FA" android:textSize="9sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EVENT / ERROR TRACE" android:textColor="#FF4D67" android:textSize="8sp" android:paddingTop="4dp"/></LinearLayout>
        </GridLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IDENTITY ANALYSIS CORE  /  FACE ENGINE" android:textColor="#49D9FF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/faceStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FACE INDEX • 0 وجه • 0 بصمة" android:textColor="#E5F4FA" android:textSize="13sp" android:textStyle="bold" android:paddingTop="7dp" />
        <Button android:id="@+id/buildFaceIndexButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="BUILD FACE INTELLIGENCE INDEX" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="50dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VISUAL INTELLIGENCE  /  MOBILECLIP-S2" android:textColor="#49D9FF" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/modelStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○  MobileCLIP-S2  /  NOT IMPORTED" android:textColor="#E5F4FA" android:textSize="13sp" android:textStyle="bold" android:paddingTop="7dp" />
        <Button android:id="@+id/importModelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="IMPORT LOCAL TFLITE MODEL" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="48dp" />
        <Button android:id="@+id/buildVisualIndexButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="BUILD / UPDATE VISUAL INDEX" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="48dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" android:background="@drawable/bg_intel_panel" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SEARCH COMMAND  /  MULTI-MODAL" android:textColor="#49D9FF" android:textSize="10sp" android:textStyle="bold" />
        <EditText android:id="@+id/searchEditText" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="8dp" android:hint="رجل في غرفة وبجانبه كلب / سرير" android:textColorHint="#567687" android:textColor="#E7F2FF" android:inputType="text" android:textDirection="locale" android:background="@drawable/bg_search" android:paddingStart="14dp" android:paddingEnd="14dp" />
        <Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RUN INTELLIGENCE SEARCH" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="50dp" />
        <Button android:id="@+id/semanticSearchButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="SEARCH BY IMAGE / VISUAL SIMILARITY" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="50dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
        <Button android:id="@+id/selectButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="INDEX PHOTOS" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="48dp" />
        <Button android:id="@+id/dataCenterButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:text="DATA CENTER" android:textColor="#E9FFD2" android:textStyle="bold" android:background="@drawable/bg_intel_button" android:minHeight="48dp" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progressBar" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:visibility="gone" style="?android:attr/progressBarStyleHorizontal" android:progressTint="#7DFF19" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="LIVE EVIDENCE FEED  /  EVENT STREAM" android:textColor="#7196AA" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/resultsRecyclerView" android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="7dp" android:clipToPadding="false" android:background="@drawable/bg_intel_panel" android:padding="5dp" />
</LinearLayout>
</ScrollView>
