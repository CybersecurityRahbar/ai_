<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#162C36" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#B7FF00" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="90" android:startColor="#101E2B" android:endColor="#0B141E" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#29445A" />
        </shape>
    </item>
</selector>
