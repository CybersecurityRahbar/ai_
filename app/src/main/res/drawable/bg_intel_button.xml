<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#B8FF00" android:endColor="#48D900" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#E8FFB0" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#193B2A" android:endColor="#0D2019" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#7DFF19" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
