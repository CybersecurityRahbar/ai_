<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <gradient android:angle="0" android:startColor="#18201E" android:endColor="#0B1110" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#39433F" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="0" android:startColor="#D7FF35" android:centerColor="#9EFF00" android:endColor="#38B900" />
            <corners android:radius="13dp" />
            <stroke android:width="2dp" android:color="#F3FFC7" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient android:angle="0" android:startColor="#244D37" android:centerColor="#173D2B" android:endColor="#0D211A" />
            <corners android:radius="13dp" />
            <stroke android:width="2dp" android:color="#B8FF00" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#244C35" android:centerColor="#193B2A" android:endColor="#0D2019" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#7DFF19" />
            <padding android:left="16dp" android:top="12dp" android:right="16dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
