<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient android:angle="0" android:startColor="#35151B" android:centerColor="#170B10" android:endColor="#08090C" />
            <stroke android:width="1dp" android:color="#8A2336" />
