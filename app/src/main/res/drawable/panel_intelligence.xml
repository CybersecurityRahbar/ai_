<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="14dp" />
            <gradient
                android:angle="90"
                android:startColor="#203B38"
                android:centerColor="#0E1D20"
                android:endColor="#07110F" />
            <stroke android:width="1dp" android:color="#2B5C4D" />
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape>
            <corners android:radius="13dp" />
            <gradient
                android:angle="0"
                android:startColor="#1A302E"
                android:endColor="#0A1516" />
            <stroke android:width="1dp" android:color="#173D35" />
        </shape>
    </item>
</layer-list>
